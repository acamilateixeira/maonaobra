{
  "info": {
    "name": "Mão na Obra Prototype — HTTP smoke",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "pagePath",
      "value": "/"
    }
  ],
  "item": [
    {
      "name": "Load HTML",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}{{pagePath}}",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('HTML document', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html'));"
            ]
          }
        }
      ]
    }
  ]
}
